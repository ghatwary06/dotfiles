// ══════════════════════════════════════════════════════════════════════════
//  niri + DankMaterialShell (instantrahmen/dms)
//
//  DMS owns the whole UI layer: top bar, dock, Spotlight launcher, control
//  center, notifications, lock screen, wallpaper, OSDs and theming. There is
//  no waybar / fuzzel / mako / swayosd / awww here — DMS replaces every one
//  of them, and running both would fight over the same DBus names.
//
//  Colors come from matugen, generated off the current wallpaper into
//  dankshell-colors.kdl and included at the bottom of this file.
//
//  Shell config: ~/.config/quickshell/dms
//  Settings:     ~/.config/DankMaterialShell/settings.json (or Mod+Shift+,)
// ══════════════════════════════════════════════════════════════════════════


// ────────────────────────────── Input ──────────────────────────────

input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 250
        repeat-rate 40
        numlock
    }

    touchpad {
        tap
        dwt                                   // ignore touchpad while typing
        natural-scroll
        accel-profile "adaptive"
        scroll-method "two-finger"
    }

    mouse {
        accel-profile "flat"
    }

    warp-mouse-to-focus
    workspace-auto-back-and-forth
}


// ───────────────────────────── Outputs ─────────────────────────────

output "HDMI-A-1" {
    mode "1920x1080@143.999"
    scale 1
    position x=0 y=0
}

output "eDP-1" {
    mode "1920x1200@144.002"
    scale 1
    position x=1920 y=0
}


// ───────────────────────────── Layout ──────────────────────────────
// Colors deliberately omitted — dankshell-colors.kdl at the bottom sets
// focus-ring / tab-indicator / insert-hint from the wallpaper palette.

layout {
    gaps 12
    background-color "transparent"            // DMS paints the wallpaper

    center-focused-column "on-overflow"
    always-center-single-column
    empty-workspace-above-first

    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }

    focus-ring {
        width 2
    }

    border {
        off
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
    }

    tab-indicator {
        place-within-column
        position "left"
        width 4
        gap 6
        gaps-between-tabs 4
        corner-radius 4
        hide-when-single-tab
    }

    // DMS draws a top bar — reserve room so windows don't slide under it.
    struts {
        top 4
    }
}


// ─────────────────────────── Workspaces ────────────────────────────

workspace "code"  { open-on-output "HDMI-A-1"; }
workspace "web"   { open-on-output "HDMI-A-1"; }
workspace "study" { open-on-output "HDMI-A-1"; }
workspace "chat"  { open-on-output "eDP-1"; }


// ──────────────────────────── Animations ───────────────────────────

animations {
    slowdown 1.0

    workspace-switch {
        spring damping-ratio=0.95 stiffness=1100 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=0.9 stiffness=950 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.88 stiffness=900 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.92 stiffness=800 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-quad"
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }
}


overview {
    zoom 0.45
}

gestures {
    hot-corners {
        // top-left → overview
    }
}

// DMS surfaces its own config errors, so niri's built-in popup is redundant.
config-notification {
    disable-failed
}


// ──────────────────────────── Startup ──────────────────────────────

spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"

// DankMaterialShell — bar, dock, launcher, notifications, lock, wallpaper.
spawn-at-startup "qs" "-c" "dms"

// Clipboard history feeds DMS's clipboard manager (Mod+V).
spawn-sh-at-startup "wl-paste --type text  --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"

// Secret storage for VS Code tokens, git credentials, browser logins.
spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets,ssh"


// ────────────────────────── Environment ────────────────────────────

environment {
    DISPLAY ":0"                              // for xwayland-satellite
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"

    ELECTRON_OZONE_PLATFORM_HINT "auto"       // VS Code native Wayland
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // NVIDIA hardware video decode.
    LIBVA_DRIVER_NAME "nvidia"
    NVD_BACKEND "direct"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"

    EDITOR "nvim"
    BROWSER "librewolf"
}


// ────────────────────────── Window rules ───────────────────────────

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^(code|Code|code-oss|codium|jetbrains-.*)$"#
    open-on-workspace "code"
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id=r#"^(librewolf|LibreWolf|firefox|chromium|brave-browser)$"#
    open-on-workspace "web"
}

// Half width keeps fastfetch on its wide layout (~98 columns).
window-rule {
    match app-id=r#"^(kitty|Alacritty)$"#
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id=r#"^(Spotify|spotify)$"#
    open-on-workspace "chat"
}

window-rule {
    match title=r#"^(Picture-in-Picture|Picture in picture)$"#
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
    default-column-width { fixed 480; }
    open-focused false
}

window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|Bitwarden|1Password)$"#
    block-out-from "screencast"
}


// ──────────────────────────── Keybinds ─────────────────────────────
//  DMS binds are marked [dms] — they call the shell over IPC.
//  Two of DMS's suggested binds were moved because they collided with core
//  scrolling-layout actions: Settings Mod+, → Mod+Shift+, (Mod+, consumes a
//  window into the column) and Power Menu Mod+X → Mod+Shift+X (Mod+X
//  maximizes the column).

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ─── DankMaterialShell ───
    Mod+Space       hotkey-overlay-title="Spotlight Launcher" { spawn "qs" "-c" "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+D           hotkey-overlay-title="Spotlight Launcher" { spawn "qs" "-c" "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+V           hotkey-overlay-title="Clipboard Manager"  { spawn "qs" "-c" "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+M           hotkey-overlay-title="Task Manager"       { spawn "qs" "-c" "dms" "ipc" "call" "processlist" "toggle"; }
    Mod+N           hotkey-overlay-title="Notification Center" { spawn "qs" "-c" "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+P           hotkey-overlay-title="Notepad"            { spawn "qs" "-c" "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+Shift+Comma hotkey-overlay-title="DMS Settings"       { spawn "qs" "-c" "dms" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+X     hotkey-overlay-title="Power Menu"         { spawn "qs" "-c" "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Alt+L       hotkey-overlay-title="Lock Screen"        { spawn "qs" "-c" "dms" "ipc" "call" "lock" "lock"; }
    Mod+Shift+N     hotkey-overlay-title="Night Mode" allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "night" "toggle"; }

    // ─── Wallpaper (DMS wallpaper service) ───
    // Picker is also under Settings → Personalization; these are the shortcuts.
    Mod+Shift+W      hotkey-overlay-title="Wallpaper Picker"   { spawn "qs" "-c" "dms" "ipc" "call" "file" "browse" "wallpaper"; }
    Mod+Ctrl+W       hotkey-overlay-title="Next Wallpaper"     { spawn "qs" "-c" "dms" "ipc" "call" "wallpaper" "next"; }
    Mod+Ctrl+Shift+W hotkey-overlay-title="Previous Wallpaper" { spawn "qs" "-c" "dms" "ipc" "call" "wallpaper" "prev"; }

    // ─── Shell toggles ───
    Mod+Shift+B hotkey-overlay-title="Hide / Show Top Bar" { spawn "qs" "-c" "dms" "ipc" "call" "bar" "toggle"; }
    Mod+Shift+D hotkey-overlay-title="Light / Dark Theme"  { spawn "qs" "-c" "dms" "ipc" "call" "theme" "toggle"; }
    Mod+I       hotkey-overlay-title="Idle Inhibitor"      { spawn "qs" "-c" "dms" "ipc" "call" "inhibit" "toggle"; }

    // ─── Apps ───
    Mod+Return  hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+B       hotkey-overlay-title="Browser"  { spawn "librewolf"; }
    Mod+C       hotkey-overlay-title="VS Code"  { spawn "code"; }
    Mod+E       hotkey-overlay-title="Files"    { spawn "dolphin"; }
    Mod+Shift+M hotkey-overlay-title="Spotify"  { spawn-sh "spotify-launcher || spotify || flatpak run com.spotify.Client"; }
    Mod+Q       hotkey-overlay-title="Close Window" { close-window; }

    // ─── Focus ───  hjkl and arrows both
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // ─── Move ───
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ─── Monitors ───
    Mod+Shift+H          { focus-monitor-left; }
    Mod+Shift+L          { focus-monitor-right; }
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ─── Building columns ───
    Mod+Comma        hotkey-overlay-title="Pull Window Into Column"   { consume-window-into-column; }
    Mod+Period       hotkey-overlay-title="Push Window Out of Column" { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+W            hotkey-overlay-title="Tab the Column" { toggle-column-tabbed-display; }

    // ─── Sizing ───
    Mod+R       hotkey-overlay-title="Cycle Column Width"  { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Cycle Window Height" { switch-preset-window-height; }
    Mod+Minus   { set-column-width "-10%"; }
    Mod+Equal   { set-column-width "+10%"; }
    Mod+Ctrl+F  { expand-column-to-available-width; }
    Mod+Z       hotkey-overlay-title="Center Column" { center-column; }
    Mod+Ctrl+Z  { center-visible-columns; }

    // ─── Modes ───
    Mod+F       { fullscreen-window; }
    Mod+Shift+F hotkey-overlay-title="Windowed Fullscreen" { toggle-windowed-fullscreen; }
    Mod+X       hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+T       hotkey-overlay-title="Float / Unfloat" { toggle-window-floating; }
    Mod+Shift+T hotkey-overlay-title="Focus Floating / Tiling" { switch-focus-between-floating-and-tiling; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    // ─── Workspaces ───
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Tab            { focus-workspace-previous; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    // ─── Screenshots ───
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }
    Mod+Shift+S { screenshot; }

    // ─── Media / brightness ───  routed through DMS so its OSD shows
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute         allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "audio" "micmute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "-c" "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }

    // ─── Session ───
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}


// ──────────────────────────── Misc ─────────────────────────────────

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y%m%d-%H%M%S.png"

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "macOS"
    xcursor-size 24
}

debug {
    // Render on the NVIDIA GPU, which drives HDMI-A-1. Without this niri picks
    // the Intel iGPU and copies every frame across — stutter below 144 Hz.
    render-drm-device "/dev/dri/renderD129"
}


// ── Wallpaper-derived colors from matugen. Last, so it wins. ────────
include "dankshell-colors.kdl"
