// ===========================================================================
//  waybar — "muted terminal"
//  Styling: style.css + colors.css.  Panel/dashboard/taskbar: `qs -c panel`.
//
//  Left    os button only — workspace pills AND the running-apps taskbar are
//          rendered by Quickshell (BarStrip.qml) so they sit flush together.
//  Centre  weather + now-playing, one chip; click either -> dashboard
//  Right   system glance · network · volume · quick toggles · battery · clock
//          · tray · notifications · power
//
//  Accent (#5E81AC) appears on: the weather glyph (span added by weather.sh),
//  the mpris play/pause glyph (span below), the focused taskbar item and the
//  active workspace pill (both in QML). Everything else stays greyscale.
// ===========================================================================
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left": [
        "custom/os"
    ],
    "modules-center": [
        "group/center"
    ],
    "modules-right": [
        "custom/sysglance",
        "custom/net",
        "pulseaudio",
        "group/toggles",
        "battery",
        "custom/weather",
        "hyprland/language",
        "tray",
        "group/session"
    ],
    "custom/os": {
        "format": "  ",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "group/center": {
        "orientation": "horizontal",
        "modules": [
            "clock#center",
            "custom/media-sep",
            "custom/media-prev",
            "mpris",
            "custom/media-next"
        ]
    },
    "clock#center": {
        // Centre of the bar. 12-hour, seconds off — this is the glanceable one.
        // Clicking opens the Quickshell dashboard, which carries the weather
        // detail + 3-day outlook that used to live in this slot.
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip": false,
        "on-click": "qs -c panel ipc call dash toggle"
    },
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 60,
        "on-click": "qs -c panel ipc call dash toggle"
    },
    "custom/media-sep": {
        "exec": "~/.config/waybar/scripts/mediabtn.sh sep",
        "interval": 2,
        "tooltip": false
    },
    "custom/media-prev": {
        "exec": "~/.config/waybar/scripts/mediabtn.sh prev",
        "interval": 2,
        "tooltip": false,
        "on-click": "playerctl previous"
    },
    "mpris": {
        "format": "<span color='#5E81AC'>{status_icon}</span> {dynamic}",
        "format-paused": "<span color='#5E81AC'>{status_icon}</span> {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-separator": "  ·  ",
        "dynamic-len": 58,
        "title-len": 36,
        "artist-len": 20,
        "status-icons": {
            "playing": "󰏤",
            "paused": "󰐊",
            "stopped": "󰓛"
        },
        "tooltip-format": "{player} — {status}\r{title}\r{artist}\r{album}\r\rclick → play/pause · right-click → dashboard",
        "on-click": "playerctl play-pause",
        "on-click-right": "qs -c panel ipc call dash toggle",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "ignored-players": [
            "firefox"
        ]
    },
    "custom/media-next": {
        "exec": "~/.config/waybar/scripts/mediabtn.sh next",
        "interval": 2,
        "tooltip": false,
        "on-click": "playerctl next"
    },
    "custom/sysglance": {
        "exec": "~/.config/waybar/scripts/sysglance.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "qs -c panel ipc call panel tab system"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "swayosd-client --output-volume mute-toggle 2>/dev/null || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        // Right-click picks the OUTPUT (headset / monitor / speakers) via a
        // themed rofi list. pavucontrol moved to middle-click — it is still the
        // right tool for per-app routing, just not for "send this to my
        // headphones", which is the common case.
        "on-click-right": "~/.config/rofi/audio-menu.sh",
        "on-click-middle": "pavucontrol",
        "on-scroll-up": "swayosd-client --output-volume raise 2>/dev/null || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "swayosd-client --output-volume lower 2>/dev/null || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },
    "group/toggles": {
        "orientation": "horizontal",
        "modules": [
            "custom/wifi",
            "custom/bt",
            "custom/dnd",
            "custom/night"
        ]
    },
    "custom/wifi": {
        "exec": "~/.config/waybar/scripts/toggles.sh wifi status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggles.sh wifi toggle",
        "on-click-right": "~/.config/rofi/wifi-menu.sh",
        "tooltip": true
    },
    "custom/bt": {
        "exec": "~/.config/waybar/scripts/toggles.sh bt status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggles.sh bt toggle",
        "on-click-right": "blueman-manager",
        "tooltip": true
    },
    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/toggles.sh dnd status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggles.sh dnd toggle",
        "signal": 8,
        "tooltip": true
    },
    "custom/night": {
        "exec": "~/.config/waybar/scripts/toggles.sh night status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggles.sh night toggle",
        "tooltip": true
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 full",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip-format": "{timeTo} — {power:.1f}W"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%a %d %b}",
        "tooltip": false,
        "on-click": "qs -c panel ipc call dash toggle"
    },
    "hyprland/language": {
        // Windows-style layout indicator. Alt+Shift is handled by XKB itself;
        // this is the visual confirmation of which layout is live, and clicking
        // cycles too, for when your hands are already on the mouse.
        //
        // waybar 0.15's hyprland/language supports ONLY the bare "{}"
        // placeholder — {short}, {long}, {shortDescription} and {variant} all
        // fail with "argument not found" and DISABLE the module entirely.
        // "{}" is the long name ("English (US)"), far too wide for the bar, so
        // the per-language overrides below carry the display text; "{}" is only
        // the fallback for a layout we have not named here.
        "format": "{}",
        "format-en": "EN",
        "format-ar": "\u0639",
        "format-ara": "\u0639",
        "on-click": "hyprctl switchxkblayout current next",
        "tooltip": false
    },
    "tray": {
        "spacing": 10,
        "icon-size": 15,
        "tooltip": false
    },
    "group/session": {
        "orientation": "horizontal",
        "modules": [
            "custom/notif",
            "custom/power"
        ]
    },
    "custom/notif": {
        "exec": "~/.config/waybar/scripts/notif.sh",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "on-click": "qs -c panel ipc call panel tab notifications",
        "on-click-right": "qs -c panel ipc call notifs toggleDnd"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "~/.config/rofi/powermenu.sh"
    },
    "custom/net": {
        "exec": "~/.config/waybar/scripts/toggles.sh net status",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggles.sh net toggle",
        "on-click-right": "~/.config/rofi/wifi-menu.sh"
    }
}
