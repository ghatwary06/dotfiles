{
    "layer": "top",
    "position": "top",
    "height": 35,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,

    "modules-left": [
        "custom/os",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "tray"
    ],

    "custom/os": {
        "format": " 󰣛 ",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "HDMI-A-1": [1, 2, 3, 4, 5],
            "eDP-1": [6, 7, 8, 9, 10]
        }
    },
    "clock": {
        "format": "[ 󰥔 {:%I:%M %p} ]",
        "format-alt": "[ 󰃭 {:%a, %b %d %Y} ]",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "[ {icon} {volume}% ]",
        "format-muted": "[  muted ]",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "swayosd-client --output-volume mute-toggle 2>/dev/null || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "flatpak run com.saivert.pwvucontrol",
        "on-scroll-up": "swayosd-client --output-volume raise 2>/dev/null || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "swayosd-client --output-volume lower 2>/dev/null || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": false
    },
    "bluetooth": {
        "format": "[ 󰂯 ]",
        "format-disabled": "[ 󰂲 ]",
        "format-off": "[ 󰂲 ]",
        "format-connected": "[ 󰂱 {num_connections} ]",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "flatpak run io.github.ebonjaeger.bluejay"
    },
    "network": {
        "format-wifi": "[ 󰤨 {essid} ]",
        "format-ethernet": "[ 󰈀 Ethernet ]",
        "format-disconnected": "[ 󰤭 No Network ]",
        "on-click": "/home/mazenghatwary/.config/rofi/wifi-menu.sh",
        "tooltip": false
    },
    "battery": {
        "format": "[ {icon} {capacity}% ]",
        "format-charging": "[ 󰂄 {capacity}% ]",
        "format-full": "[ 󰁹 Full ]",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip": false
    },
    "tray": {
        "spacing": 8,
        "tooltip": false
    }
}
