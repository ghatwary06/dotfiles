{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "fedora",
        "color": {
            "1": "34",
            "2": "34"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  →  ",
        "color": {
            "keys": "34",
            "title": "34"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user-name": "35",
                "at": "37",
                "host-name": "34"
            }
        },
        "separator",
        {"type": "os",       "key": "󰣇  OS      ", "keyColor": "34"},
        {"type": "kernel",   "key": "󰌽  Kernel  ", "keyColor": "34"},
        {"type": "uptime",   "key": "󰅐  Uptime  ", "keyColor": "34"},
        {"type": "shell",    "key": "󰞷  Shell   ", "keyColor": "34"},
        {"type": "wm",       "key": "󱂬  WM      ", "keyColor": "34"},
        {"type": "terminal", "key": "󰆍  Term    ", "keyColor": "34"},
        {"type": "cpu",      "key": "󰻠  CPU     ", "keyColor": "34"},
        {"type": "gpu",      "key": "󰍛  GPU     ", "keyColor": "34"},
        {"type": "memory",   "key": "󰍛  Memory  ", "keyColor": "34"},
        {"type": "disk",     "key": "󰋊  Disk    ", "keyColor": "34"},
        "separator",
        {"type": "colors", "paddingLeft": 2, "symbol": "circle"}
    ]
}
