{
    // fastfetch — wide layout, Nord.
    // Renders at most ~86 columns. fish picks this only when the terminal is
    // wide enough; anything narrower gets compact.jsonc instead, because
    // fastfetch does NOT reflow — it just wraps into the logo and looks broken.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/cachyos.txt",
        "color": {
            "1": "38;2;94;129;172",   // mauve
            "2": "38;2;129;161;193"    // blue
        },
        "padding": { "top": 1, "left": 2, "right": 3 }
    },

    "display": {
        "separator": " · ",
        "key": { "width": 9 },
        "color": { "separator": "38;2;97;110;136" }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user-name": "38;2;94;129;172",   // mauve
                "at":        "38;2;97;110;136",   // overlay0
                "host-name": "38;2;129;161;193"    // blue
            }
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;67;76;94m────────────────────────────────────"
        },

        { "type": "os",     "key": "󰣇 os",   "keyColor": "38;2;94;129;172" },
        { "type": "kernel", "key": "󰌽 krnl", "keyColor": "38;2;129;161;193" },
        { "type": "uptime", "key": "󰅐 up",   "keyColor": "38;2;129;161;193" },
        { "type": "wm",     "key": "󱂬 wm",   "keyColor": "38;2;136;192;208" },
        { "type": "shell",  "key": "󰞷 sh",   "keyColor": "38;2;143;188;187" },

        {
            "type": "custom",
            "format": "\u001b[38;2;67;76;94m────────────────────────────────────"
        },

        {
            "type": "cpu",
            "key": "󰻠 cpu",
            "keyColor": "38;2;163;190;140",
            "format": "{name} ({cores-logical})",
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": "󰢮 gpu",
            "keyColor": "38;2;235;203;139",
            "format": "{name}",
            "hideType": "integrated"
        },
        {
            "type": "memory",
            "key": "󰍛 mem",
            "keyColor": "38;2;208;135;112",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "󰋊 disk",
            "keyColor": "38;2;180;142;173",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },

        "break",
        { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
        "break"
    ]
}
