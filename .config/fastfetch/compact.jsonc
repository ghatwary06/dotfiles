{
    // fastfetch — narrow layout for niri columns, Nord.
    // Renders at most ~46 columns, so it survives a 1/3-width column.
    // fish auto-selects this when $COLUMNS is below the wide layout's needs.
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/cachyos-small.txt",
        "color": {
            "1": "38;2;94;129;172",   // mauve
            "2": "38;2;129;161;193"    // blue
        },
        "padding": { "top": 1, "left": 1, "right": 2 }
    },

    "display": {
        "separator": " ",
        "key": { "width": 2 },
        "color": { "separator": "38;2;97;110;136" }
    },

    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user-name": "38;2;94;129;172",
                "at":        "38;2;97;110;136",
                "host-name": "38;2;129;161;193"
            }
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;67;76;94m──────────────────────"
        },

        { "type": "os",     "key": "󰣇", "keyColor": "38;2;94;129;172", "format": "{name}" },
        { "type": "kernel", "key": "󰌽", "keyColor": "38;2;129;161;193", "format": "{release}" },
        { "type": "uptime", "key": "󰅐", "keyColor": "38;2;129;161;193" },
        { "type": "wm",     "key": "󱂬", "keyColor": "38;2;136;192;208", "format": "{pretty-name}" },
        { "type": "shell",  "key": "󰞷", "keyColor": "38;2;143;188;187", "format": "{pretty-name}" },
        {
            "type": "memory",
            "key": "󰍛",
            "keyColor": "38;2;208;135;112",
            "format": "{used} / {total}"
        },

        "break",
        { "type": "colors", "paddingLeft": 1, "symbol": "circle" }
    ]
}
